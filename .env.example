# AI Configuration for StudyMate AI

# Choose your AI provider: 'gemini' or 'ollama' or 'none'
VITE_AI_PROVIDER=gemini

# ===== GOOGLE GEMINI CONFIGURATION =====
# Get your API key from: https://makersuite.google.com/app/apikey
# (Note: Gemini is free to use, no credit card required)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ===== OLLAMA CONFIGURATION (LOCAL) =====
# Ollama allows you to run AI models locally offline
# Download from: https://ollama.ai
# Run locally with: ollama serve

# Ollama server address (default: http://localhost:11434)
VITE_OLLAMA_BASE_URL=http://localhost:11434

# Model to use (e.g., 'mistral', 'llama2', 'neural-chat', etc.)
# Common models: mistral, llama2, neural-chat, orca-mini
VITE_OLLAMA_MODEL=mistral

# ===== SETUP INSTRUCTIONS =====
# 
# Option 1: Use Google Gemini (Cloud-Based, Free)
# -----------------------------------------------
# 1. Go to https://makersuite.google.com/app/apikey
# 2. Click "Create API Key"
# 3. Copy your API key
# 4. Paste it as VITE_GEMINI_API_KEY above
# 5. Set VITE_AI_PROVIDER=gemini
#
# Option 2: Use Ollama (Local, Offline, Private)
# -----------------------------------------------
# 1. Download Ollama from https://ollama.ai
# 2. Install and start Ollama
# 3. In terminal, run: ollama run mistral
#    (or any other model like: ollama run llama2, ollama run neural-chat)
# 4. It will download and start the model locally
# 5. Set VITE_AI_PROVIDER=ollama
# 6. Ollama will run on http://localhost:11434 by default
#
# Option 3: Use Both (Recommended)
# --------------------------------
# You can have both configured - the app will use whichever provider is set as VITE_AI_PROVIDER
# This way you can easily switch between cloud and local models
